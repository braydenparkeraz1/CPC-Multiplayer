<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>CPC-Multiplayer</AssemblyName>
    <RootNamespace>CpcMultiplayer</RootNamespace>
    <OutputType>Exe</OutputType>
    <!-- The original targets .NET Framework 4.0 so it runs on any Windows without installing a runtime. -->
    <TargetFramework>net40</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>12.0</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- Only src/ is the helper; tests/ holds a separate stand-in game. -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src\**\*.cs" />
    <!-- Lua scripts the helper installs into the game folder, embedded as "lua.<name>". -->
    <EmbeddedResource Include="lua\*.lua" LogicalName="lua.%(Filename)" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Core" />
  </ItemGroup>
</Project>
